[Unit]
Description=TECHNET DOMINIUM web backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dominium
Group=dominium
WorkingDirectory=/opt/dominium
EnvironmentFile=/opt/dominium/.env
ExecStart=/opt/dominium/.venv/bin/python /opt/dominium/app.py --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT

# Hardening basico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/dominium
UMask=0077

[Install]
WantedBy=multi-user.target
