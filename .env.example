# DOMINIUM web / production
DOMINIUM_WEB_MODE=1
DOMINIUM_HTTPS=1
DOMINIUM_PUBLIC_ORIGIN=https://dominium.clarotechnet.com.br

# Autenticacao
DOMINIUM_AUTH_BACKEND=supabase
# O cadastro publico cria solicitacao pendente; somente admin aprova e escolhe o cargo.
DOMINIUM_ALLOW_REGISTRATION=1
DOMINIUM_ALLOW_WEB_BOOTSTRAP=0
# Identidade interna do Supabase Auth. Nao precisa existir como dominio publico.
DOMINIUM_AUTH_EMAIL_DOMAIN=auth.dominium.invalid

# Supabase - somente no servidor; nunca enviar ao navegador
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=COLOQUE_A_SECRET_KEY_AQUI

# Receptor do bot/TOA. Gere um segredo longo e aleatorio.
DOMINIUM_INGEST_TOKEN=COLOQUE_UM_TOKEN_FORTE_AQUI

# Alternativa ao Supabase, se um dia quiser PostgreSQL direto:
# DOMINIUM_DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
