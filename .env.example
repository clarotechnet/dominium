# DOMINIUM web / production
DOMINIUM_WEB_MODE=1
DOMINIUM_PROJECT_ROOT=C:\DominiumMain
DOMINIUM_HTTPS=1
DOMINIUM_PUBLIC_ORIGIN=https://dominium.clarotechnet.com.br
# Confie em X-Forwarded-* somente quando o backend estiver atras do Caddy controlado pela Technet.
DOMINIUM_TRUST_PROXY_HEADERS=1
# Segredo compartilhado somente entre Caddy e backend. Gere com pelo menos 32 bytes aleatorios.
DOMINIUM_PROXY_TOKEN=COLOQUE_UM_TOKEN_ALEATORIO_FORTE_AQUI

# No servidor Windows, permita que o modo web apenas se anexe ao Chrome TOA ja aberto.
# Isso nao inicia a automacao TOA local nem cria outro navegador.
DOMINIUM_WEB_ATTACH_TOA=0
DOMINIUM_TOA_DEBUG_PORT=9339
# Opcional: fixe um ChromeDriver compativel com a versao do Chrome do servidor.
# DOMINIUM_CHROMEDRIVER=C:\\DominiumRuntime\\ChromeDriver\\153.0.8010.52\\chromedriver.exe

# Autenticacao
DOMINIUM_AUTH_BACKEND=supabase
# O cadastro publico cria solicitacao pendente; somente admin aprova e escolhe o cargo.
DOMINIUM_ALLOW_REGISTRATION=1
DOMINIUM_ALLOW_WEB_BOOTSTRAP=0
# Identidade interna do Supabase Auth. Nao precisa existir como dominio publico.
DOMINIUM_AUTH_EMAIL_DOMAIN=auth.dominium.invalid

# Supabase - somente no servidor; nunca enviar ao navegador
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=COLOQUE_A_SECRET_KEY_AQUI

# Receptor do bot/TOA. Gere um segredo longo e aleatorio.
DOMINIUM_INGEST_TOKEN=COLOQUE_UM_TOKEN_FORTE_AQUI

# Alternativa ao Supabase, se um dia quiser PostgreSQL direto:
# DOMINIUM_DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
