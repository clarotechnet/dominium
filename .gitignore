# Python / local virtualenv
__pycache__/
*.pyc
.venv/
.ruff_cache/

# Secrets and machine-local configuration
.env
.env.*
!.env.example
!deploy/windows-server/.env.production.example
.secrets/
config/*.dat
config/*.dat.*

# Runtime state and generated artifacts
logs/
logs-agente-local/
tmp/
backups/
captures/
diagnostics/
output/
reports/
data/
dist/
coverage/
.pytest_cache/
.mypy_cache/
.coverage
config/toa_chrome_profile/
config/toa_chrome_profile_backup_*/
config/official_close_operations/
config/official_material_catalog/
config/official_stock_audit/
