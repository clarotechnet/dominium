# Dependency/build caches and local integration credentials
**/node_modules/
**/.wrangler/
integrations/toa_cloud_bridge/.dev.vars

# Scratch / generated inspection files
*.log
*.bak
*.bak_*
*.tmp
*.inspect.ndjson
tmp_*
scratch_*
diff_step_*
found_step.json
step_*.txt
*.pcapng

# Local deployment/runtime helpers
deploy/*.local
config/whatsapp_bridge/
whatsapp_connector/node_modules/

# Machine-local TLS/SSH material (never version)
deploy/windows-server/serveo_*_ed25519
deploy/windows-server/serveo_*_ed25519.pub
deploy/windows-server/caddy-local-root.crt
deploy/windows-server/*.key
deploy/windows-server/*.pem
